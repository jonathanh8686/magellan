# Copy this file to .env and fill in real values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=

# Prefix for legacy text commands. Slash commands are unaffected.
COMMAND_PREFIX=!

# Optional: guild ID to sync slash commands to instantly during development.
# Leave blank to sync globally (can take up to an hour to propagate).
DEV_GUILD_ID=
