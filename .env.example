# Copy this file to .env and fill in real values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=

# Prefix for legacy text commands. Slash commands are unaffected.
COMMAND_PREFIX=!

# Optional: guild ID to sync slash commands to instantly during development.
# Leave blank to sync globally (can take up to an hour to propagate).
DEV_GUILD_ID=

# Required for /event: the role ID everyone on the trip has in the server.
# /event create DMs every member with this role. Right-click the role in
# Discord (Server Settings > Roles, or with Developer Mode on) > Copy ID.
TRAVELER_ROLE_ID=

# Optional: where the sqlite database (plans + RSVPs) is stored.
DB_PATH=data/magellan.db
